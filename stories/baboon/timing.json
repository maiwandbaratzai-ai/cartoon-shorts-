 "lines": [
  {
   "text": "For nine years, a baboon ran this railway's train signals.",
   "s": 0.12,
   "e": 3.074
  },
  {
   "text": "Every morning, he pushed his boss to work on a little rail trolley.",
   "s": 3.374,
   "e": 6.454
  },
  {
   "text": "James had wooden legs, so Jack the baboon did the pushing.",
   "s": 6.754,
   "e": 9.488
  },
  {
   "text": "Then Jack started copying James at the signal levers.",
   "s": 9.788,
   "e": 12.293
  },
  {
   "text": "A train whistled four times, so Jack yanked lever four.",
   "s": 12.593,
   "e": 15.089
  },
  {
   "text": "But it gets weirder: a passenger screamed, a monkey's switching the tracks!",
   "s": 15.389,
   "e": 18.825
  },
  {
   "text": "So the railway sent an inspector to fire him.",
   "s": 19.125,
   "e": 21.294
  },
  {
   "text": "Jack aced the test instead.",
   "s": 21.944,
   "e": 23.196
  },
  {
   "text": "They hired him on the spot: twenty cents a day, plus beer.",
   "s": 23.496,
   "e": 26.14
  },
  {
   "text": "Nine years later, still not one mistake.",
   "s": 26.44,
   "e": 28.375
  }
 ],

 "lines": [
  {
   "text": "In 1932, Australia's army went to war against birds, and lost.",
   "s": 0.12,
   "e": 4.752
  },
  {
   "text": "Twenty thousand emus were eating the wheat farms of Western Australia.",
   "s": 5.052,
   "e": 9.308
  },
  {
   "text": "So the army sent a major, two soldiers, and two machine guns.",
   "s": 9.608,
   "e": 13.377
  },
  {
   "text": "But every time they aimed, the emus scattered in all directions.",
   "s": 13.677,
   "e": 17.317
  },
  {
   "text": "They mounted a gun on a truck. The emus were faster than the truck.",
   "s": 17.617,
   "e": 21.14
  },
  {
   "text": "After a week, they'd fired twenty-five hundred bullets, and the emus were still there.",
   "s": 21.44,
   "e": 26.088
  },
  {
   "text": "The army pulled out. The emus won.",
   "s": 26.388,
   "e": 28.474
  }
 ],

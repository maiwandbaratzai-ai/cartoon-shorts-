 "lines": [
  {
   "text": "A sheep hid in a cave for six years, dodging haircuts.",
   "s": 0.12,
   "e": 2.865
  },
  {
   "text": "When farmers found him, he looked like a giant cloud with legs.",
   "s": 3.164,
   "e": 6.226
  },
  {
   "text": "His wool weighed 27 kilos, as much as a Labrador.",
   "s": 6.526,
   "e": 9.667
  },
  {
   "text": "So much, he couldn't even see where he was walking.",
   "s": 9.967,
   "e": 12.204
  },
  {
   "text": "But could anyone shear a sheep that big?",
   "s": 12.504,
   "e": 13.999
  },
  {
   "text": "So they sheared him live on national TV, the whole country watching.",
   "s": 14.419,
   "e": 17.548
  },
  {
   "text": "Then the champion shearer switched on his clippers.",
   "s": 17.848,
   "e": 19.887
  },
  {
   "text": "Twenty minutes later, a skinny little sheep stepped out.",
   "s": 20.537,
   "e": 23.024
  },
  {
   "text": "The pile of wool was bigger than he was: enough for twenty suits.",
   "s": 23.324,
   "e": 26.365
  },
  {
   "text": "No wonder he hid for six years.",
   "s": 26.665,
   "e": 28.257
  }
 ],

 "lines": [
  {
   "text": "In 1628, Sweden's mightiest warship sank within twenty minutes.",
   "s": 0.12,
   "e": 3.869
  },
  {
   "text": "The Vasa carried sixty-four cannons and hundreds of carved statues.",
   "s": 4.169,
   "e": 7.471
  },
  {
   "text": "But it was dangerously top-heavy.",
   "s": 7.771,
   "e": 9.309
  },
  {
   "text": "In a test, thirty sailors ran across the deck. It nearly capsized.",
   "s": 9.608,
   "e": 13.045
  },
  {
   "text": "It sailed anyway, as crowds cheered in Stockholm.",
   "s": 13.345,
   "e": 15.964
  },
  {
   "text": "Then a gust tipped it, and water poured through the gun ports.",
   "s": 16.264,
   "e": 18.947
  },
  {
   "text": "It sank in minutes, and about thirty people died.",
   "s": 19.247,
   "e": 21.64
  },
  {
   "text": "Three hundred and thirty-three years later, it was raised almost intact.",
   "s": 21.94,
   "e": 25.625
  },
  {
   "text": "Today, millions visit the warship that couldn't sail a mile.",
   "s": 25.925,
   "e": 28.591
  }
 ],

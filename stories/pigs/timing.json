 "lines": [
  {
   "text": "Two pigs escaped a Malmesbury butcher and became Britain's most wanted.",
   "s": 0.12,
   "e": 3.886
  },
  {
   "text": "They squeezed through a fence and swam a freezing river.",
   "s": 4.186,
   "e": 6.375
  },
  {
   "text": "Then they vanished into the town's back gardens.",
   "s": 6.675,
   "e": 8.755
  },
  {
   "text": "So reporters worldwide chased them through the hedges.",
   "s": 9.055,
   "e": 11.486
  },
  {
   "text": "The papers named them Butch Cassidy and the Sundance Pig.",
   "s": 11.786,
   "e": 14.503
  },
  {
   "text": "But it gets weirder: vets shot Sundance with a tranquilizer dart.",
   "s": 14.803,
   "e": 18.061
  },
  {
   "text": "He barely slowed down.",
   "s": 18.711,
   "e": 19.781
  },
  {
   "text": "After a week, they caught both. Back to the butcher?",
   "s": 20.081,
   "e": 22.311
  },
  {
   "text": "No. A newspaper bought them and retired them to a farm.",
   "s": 22.731,
   "e": 25.672
  },
  {
   "text": "Britain's most wanted pigs never became bacon.",
   "s": 25.972,
   "e": 28.129
  }
 ],

 "lines": [
  {
   "text": "In 1982, a man flew a lawn chair nearly three miles up.",
   "s": 0.12,
   "e": 3.664
  },
  {
   "text": "Larry Walters tied forty-two weather balloons to a patio chair.",
   "s": 3.964,
   "e": 7.174
  },
  {
   "text": "His plan: float thirty feet above his backyard.",
   "s": 7.474,
   "e": 9.838
  },
  {
   "text": "Then the rope snapped.",
   "s": 10.138,
   "e": 11.002
  },
  {
   "text": "He rocketed to fifteen thousand feet, into the flight path of LAX.",
   "s": 11.302,
   "e": 15.199
  },
  {
   "text": "Two airline pilots reported a man in a lawn chair.",
   "s": 15.499,
   "e": 18.044
  },
  {
   "text": "He shot balloons with a pellet gun to come down,",
   "s": 18.344,
   "e": 20.489
  },
  {
   "text": "and landed in power lines, blacking out a Long Beach neighborhood.",
   "s": 20.669,
   "e": 23.786
  },
  {
   "text": "The FAA fined him fifteen hundred dollars.",
   "s": 24.086,
   "e": 26.489
  },
  {
   "text": "His reason? \"A man can't just sit around.\"",
   "s": 26.789,
   "e": 28.911
  }
 ],

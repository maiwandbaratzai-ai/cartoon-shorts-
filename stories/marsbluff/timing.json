 "lines": [
  {
   "text": "In 1958, a US bomber dropped an atomic bomb on a backyard.",
   "s": 0.12,
   "e": 3.886
  },
  {
   "text": "It blew a playhouse to splinters and dug a crater 70 feet wide.",
   "s": 4.186,
   "e": 7.387
  },
  {
   "text": "A warning light blinked, so the navigator went to check the bomb.",
   "s": 7.687,
   "e": 10.396
  },
  {
   "text": "He reached for a locking pin, but the bomb came unhooked.",
   "s": 10.697,
   "e": 13.083
  },
  {
   "text": "Two tons of explosive smashed straight through the bomb bay doors.",
   "s": 13.383,
   "e": 16.221
  },
  {
   "text": "Then it fell 15,000 feet onto Mars Bluff, South Carolina.",
   "s": 16.521,
   "e": 19.756
  },
  {
   "text": "Here's the part nobody saw coming: the nuclear core wasn't in it.",
   "s": 20.056,
   "e": 23.122
  },
  {
   "text": "Six people were hurt, nobody died. The chickens weren't so lucky.",
   "s": 23.422,
   "e": 26.55
  },
  {
   "text": "The Air Force paid $54,000. For one backyard.",
   "s": 26.85,
   "e": 30.115
  }
 ],

 "lines": [
  {
   "text": "In 2020, it snowed chocolate on a town in Switzerland.",
   "s": 0.12,
   "e": 3.171
  },
  {
   "text": "People in Olten found brown flakes all over their cars.",
   "s": 3.471,
   "e": 6.521
  },
  {
   "text": "It came from the Lindt chocolate factory right in town.",
   "s": 6.821,
   "e": 9.506
  },
  {
   "text": "A cooling fan on the cocoa-roasting line had broken.",
   "s": 9.806,
   "e": 12.419
  },
  {
   "text": "Then a strong wind grabbed the fine cocoa dust",
   "s": 12.719,
   "e": 14.925
  },
  {
   "text": "and sprinkled it across the whole neighborhood.",
   "s": 15.105,
   "e": 16.978
  },
  {
   "text": "Sidewalks and cars turned brown, like a giant mug of hot chocolate.",
   "s": 17.278,
   "e": 20.963
  },
  {
   "text": "Lindt said the cocoa dust was completely harmless.",
   "s": 21.263,
   "e": 23.672
  },
  {
   "text": "And it offered to pay for cleaning everyone's cars.",
   "s": 23.972,
   "e": 26.278
  }
 ],

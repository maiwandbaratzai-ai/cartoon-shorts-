 "lines": [
  {
   "text": "Andrew Jackson threw a party for a 1,400-pound cheese.",
   "s": 0.12,
   "e": 3.3
  },
  {
   "text": "10,000 people mobbed the White House and tore into it.",
   "s": 3.6,
   "e": 6.22
  },
  {
   "text": "The cheese was four feet wide and two feet thick.",
   "s": 6.52,
   "e": 8.598
  },
  {
   "text": "A New York dairy farmer made it as a gift.",
   "s": 8.898,
   "e": 10.825
  },
  {
   "text": "So on Washington's birthday in 1837, Jackson served it to the public.",
   "s": 11.125,
   "e": 15.418
  },
  {
   "text": "In two hours, the whole thing was gone.",
   "s": 15.718,
   "e": 17.259
  },
  {
   "text": "But the smell? The smell stayed.",
   "s": 17.559,
   "e": 18.845
  },
  {
   "text": "A reporter wrote the carpet was slippery with cheese.",
   "s": 19.145,
   "e": 21.334
  },
  {
   "text": "The next president had to air out the rooms and repaint the walls.",
   "s": 21.634,
   "e": 24.621
  },
  {
   "text": "Then he banned food at White House parties.",
   "s": 24.921,
   "e": 26.716
  },
  {
   "text": "Who throws a cheese party, anyway?",
   "s": 27.016,
   "e": 28.506
  }
 ],
